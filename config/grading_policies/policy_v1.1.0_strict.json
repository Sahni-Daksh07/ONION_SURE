{
  "version": "1.1.0_strict",
  "name": "Strict Export Grade Policy",
  "effective_date": "2026-03-01",
  "description": "High-standard export policy requiring large diameter and stringent defect tolerance.",
  "confidence_thresholds": {
    "minimum_detection_confidence": 0.80,
    "minimum_defect_confidence": 0.75,
    "manual_review_below": 0.65
  },
  "size_thresholds": {
    "undersized_max_diameter_mm": 50.0,
    "grade_a_min_diameter_mm": 55.0
  },
  "defect_rules": {
    "reject_defects": ["ROTTEN", "SPROUTED"],
    "severe_damage_confidence_threshold": 0.65,
    "minor_damage_urs_allowed": false,
    "healthy_urs_allowed_when_unmeasured": false
  },
  "lot_aggregation_rules": {
    "urs_tolerance_percent": 5.0,
    "reject_tolerance_percent": 0.5
  }
}
