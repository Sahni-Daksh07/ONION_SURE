# ==============================================================================
# ONION_SURE — Environment Variables Configuration Template
# Smart India Hackathon 2026 - Problem Statement PS26031
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
APP_NAME=ONION_SURE
APP_VERSION=1.0.0
DEBUG=True

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Security & Authentication (Generate secure secret in production, min 32 chars)
SECRET_KEY=change-this-insecure-secret-key-in-production-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Local PostgreSQL Configuration (Docker Compose)
POSTGRES_DB=onion_sure
POSTGRES_USER=onion_sure_app
POSTGRES_PASSWORD=onion_sure_secure_password_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URLs (SQLAlchemy 2.0 with modern psycopg driver)
DATABASE_URL=postgresql+psycopg://onion_sure_app:onion_sure_secure_password_2026@localhost:5432/onion_sure
DATABASE_TEST_URL=sqlite:///./test_onionsure.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# AI / ML Inference Configuration
MODEL_DIR=ml/weights
DETECTION_MODEL_PATH=ml/weights/onion_yolo_v1.pt
CLASSIFICATION_MODEL_PATH=ml/weights/classifier-v1.0.0.joblib
INFERENCE_CONFIDENCE_THRESHOLD=0.75
DEVICE=cpu

# Grading Policy Configuration
GRADING_POLICY_VERSION=1.0.0
POLICIES_CONFIG_DIR=config/grading_policies
MIN_CALIBRATED_DIAMETER_MM=40.0
URS_MAX_DEFECT_PERCENT=10.0

# Storage & Object Storage Configuration (Local / MinIO / S3)
STORAGE_TYPE=local  # local, minio, s3
STORAGE_LOCAL_DIR=uploads
STORAGE_BUCKET=onion-sure-inspections
MAX_UPLOAD_SIZE_MB=15

# Verification & Public QR Verification Endpoint
QR_BASE_URL=https://onionsure.gov.in/verify

# Flutter Mobile Application API Endpoints (Passed via --dart-define)
FLUTTER_API_BASE_URL_ANDROID_EMULATOR=http://10.0.2.2:8000/api/v1
FLUTTER_API_BASE_URL_LOCAL=http://localhost:8000/api/v1
FLUTTER_API_BASE_URL_PROD=https://api.onionsure.gov.in/api/v1
