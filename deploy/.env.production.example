# ==============================================================================
# ONION_SURE — Production Environment Variable Configuration (.env.production)
# Smart India Hackathon 2026 - Problem Statement PS26031
# ==============================================================================

# Core Application
ENVIRONMENT=production
DEBUG=False
APP_NAME=ONION_SURE
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Networking & Host
HOST=0.0.0.0
PORT=8000

# Security (CRITICAL: Generate with `openssl rand -hex 32` - Min 32 chars)
SECRET_KEY=replace-with-ultra-secure-randomly-generated-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14

# Production Database (PostgreSQL 16)
POSTGRES_DB=onion_sure
POSTGRES_USER=onion_sure_prod_user
POSTGRES_PASSWORD=replace-with-strong-db-password-at-least-20-chars
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://onion_sure_prod_user:replace-with-strong-db-password-at-least-20-chars@postgres:5432/onion_sure

# DB Connection Pool Tuning
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30

# Computer Vision & Inference Engine
DEVICE=cpu
MODEL_DIR=/app/ml/weights
DETECTION_MODEL_PATH=/app/ml/weights/onion_yolo_v1.pt
CLASSIFICATION_MODEL_PATH=/app/ml/weights/classifier-v1.0.0.joblib
INFERENCE_CONFIDENCE_THRESHOLD=0.75

# Object Storage Configuration (Local or Cloud S3)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=/app/uploads
STORAGE_BUCKET=onion-sure-inspections
MAX_UPLOAD_SIZE_MB=25

# Public Verification Base URL (Encoded into QR codes)
QR_BASE_URL=https://onionsure.gov.in/verify

# Mobile Client API Base URLs (for Flutter build)
FLUTTER_API_BASE_URL_PROD=https://api.onionsure.gov.in/api/v1
