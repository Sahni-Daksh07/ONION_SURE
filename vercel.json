{
  "version": 2,
  "cleanUrls": true,
  "public": true,
  "outputDirectory": "web",
  "rewrites": [
    {
      "source": "/dashboard/(.*)",
      "destination": "/web/$1"
    },
    {
      "source": "/",
      "destination": "/web/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
